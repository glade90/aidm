# AIDM-DES-034.1 — Copy to .env for LOCAL DEVELOPMENT ONLY.
# Never put working credentials in this example or commit your .env.
# Only simple KEY=VALUE syntax is supported (no shell expansion).
# AIDM_MODE is PROCESS-ONLY: set AIDM_MODE=test|ci|production outside .env.
# With CI=true and no explicit mode, the loader uses ci. Otherwise the
# default is development; only development may read this local file.
AIDM_DEBUG=false
AIDM_LOG_LEVEL=INFO
AIDM_REQUEST_TIMEOUT_SECONDS=30
# Provider-specific API key names will be added under AIDM-DES-015.